# Kopiere diese Datei nach .env (nur auf dem Server, steht in .gitignore).
# Connection-Pool: 2 Web-Instanzen x 10 + Worker bleiben unter dem Postgres-Limit von 100.
DATABASE_URL="postgresql://wichtel:CHANGE_ME@localhost:5432/wichtel?connection_limit=10"

APP_URL="https://wichtelwerk.neuhauser.cloud"
AUTH_URL="https://wichtelwerk.neuhauser.cloud"
# openssl rand -base64 32
AUTH_SECRET=""

# 32 Byte, base64 oder hex: openssl rand -base64 32  (Versandadressen & Gutscheincodes)
ENCRYPTION_KEY=""
# 32 Byte, base64 oder hex: openssl rand -base64 32  (Pseudonyme der Vorjahres-Paare; nach Gebrauch NICHT ändern)
PSEUDONYM_PEPPER=""

# Mail (SMTP, EU-Anbieter wie Brevo/Postmark oder eigener Server). Ohne SMTP_HOST werden Mails nur geloggt.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Wichtelwerk <noreply@wichtelwerk.neuhauser.cloud>"

# Stripe (Zahlung pro Aktion). Webhook-URL: https://wichtelwerk.neuhauser.cloud/api/stripe/webhook
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# true, wenn Stripe Tax eingerichtet ist (USt automatisch)
STRIPE_AUTOMATIC_TAX="false"

# SSO (optional, V2): Microsoft Entra ID und/oder Google Workspace
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Uploads (Firmenlogos), außerhalb des Repos und von Updates unberührt
UPLOAD_DIR="/www/wwwroot/wichtelwerk-uploads"

# Impressum / Datenschutz / AV-Vertrag
LEGAL_NAME="Mario Neuhauser"
LEGAL_ADDRESS=""
LEGAL_EMAIL="hallo@neuhauser.cloud"
LEGAL_UID=""
LEGAL_PHONE=""
